# Dependencies (installed fresh inside the container)
node_modules
npm-debug.log*

# Git and version control
.git
.gitignore
.github

# Environment secrets and local configurations
.env
.env.*
!.env.example
firebase-service-account.json
env.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts and caches
dist
build
.cache

# Documentation and IDE settings
README.md
.vscode
.idea
*.DS_Store

# Local files and tests that must not ship in the image
Dockerfile
.dockerignore
tests
coverage
jest.config.cjs
eslint.config.cjs
*.md
firebase-service-account*.json
*.local

# db/ holds local SQL (seed_admin.sql, old migrations). Only the baseline
# schema is needed, because migrations/ runs it.
db/*
!db/schema.sql
